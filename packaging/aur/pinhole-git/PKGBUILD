# Maintainer: chrischriscris <ruckrollhuke@gmail.com>

pkgname=pinhole-git
pkgver=0.1.0.r0.g0000000
pkgrel=1
pkgdesc='macOS-style screenshots and screen recordings for Hyprland and sway (latest commit)'
arch=('x86_64' 'aarch64')
url='https://github.com/chrischriscris/pinhole'
license=('MIT OR Apache-2.0')
depends=('gtk4' 'gtk4-layer-shell' 'grim' 'wl-clipboard' 'glib2' 'gcc-libs' 'glibc')
makedepends=('cargo')
optdepends=('wl-screenrec: screen recording with GPU encoding'
            'wf-recorder: screen recording on the CPU, and VP9/AV1 recordings'
            'ffmpeg: recording previews and share-friendly MP4 files'
            'satty: mark up screenshots'
            'swappy: mark up screenshots'
            'libnotify: error notifications'
            'libpulse: microphone list and mixing microphone with system audio'
            'pipewire: shutter sound'
            'sound-theme-freedesktop: shutter sound')
makedepends+=('git')
provides=('pinhole')
conflicts=('pinhole')
source=("pinhole::git+$url.git")
sha256sums=('SKIP')
_srcdir=pinhole

pkgver() {
  cd "$_srcdir"
  git describe --long --tags --abbrev=7 2>/dev/null | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g' ||
    printf '0.1.0.r%s.g%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

prepare() {
  cd "$_srcdir"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$_srcdir"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$_srcdir"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen
}

package() {
  cd "$_srcdir"
  install -Dm755 target/release/pinhole "$pkgdir/usr/bin/pinhole"
  install -Dm644 data/io.github.chrischriscris.Pinhole.desktop -t "$pkgdir/usr/share/applications"
  install -Dm644 README.md -t "$pkgdir/usr/share/doc/$pkgname"
  install -Dm644 LICENSE-MIT LICENSE-APACHE -t "$pkgdir/usr/share/licenses/$pkgname"
}
