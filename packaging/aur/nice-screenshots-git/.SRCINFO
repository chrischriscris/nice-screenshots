pkgbase = nice-screenshots-git
	pkgdesc = macOS-style screenshots and screen recordings for Hyprland and sway (latest commit)
	pkgver = 0.1.0.r0.g0000000
	pkgrel = 1
	url = https://github.com/chrischriscris/nice-screenshots
	arch = x86_64
	arch = aarch64
	license = MIT OR Apache-2.0
	makedepends = cargo
	makedepends = git
	depends = gtk4
	depends = gtk4-layer-shell
	depends = grim
	depends = wl-clipboard
	depends = glib2
	depends = gcc-libs
	depends = glibc
	optdepends = wl-screenrec: screen recording with GPU encoding
	optdepends = wf-recorder: screen recording on the CPU, and VP9/AV1 recordings
	optdepends = ffmpeg: recording previews and share-friendly MP4 files
	optdepends = satty: mark up screenshots
	optdepends = swappy: mark up screenshots
	optdepends = libnotify: error notifications
	optdepends = libpulse: microphone list and mixing microphone with system audio
	optdepends = pipewire: shutter sound
	optdepends = sound-theme-freedesktop: shutter sound
	provides = nice-screenshots
	conflicts = nice-screenshots
	source = nice-screenshots::git+https://github.com/chrischriscris/nice-screenshots.git
	sha256sums = SKIP

pkgname = nice-screenshots-git
